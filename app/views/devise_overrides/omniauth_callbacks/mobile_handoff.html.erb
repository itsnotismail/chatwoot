<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <%# The URL carries a one-time sso_auth_token; keep it out of Referer. %>
    <meta name="referrer" content="no-referrer" />
    <title><%= t('mobile_handoff.title') %></title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #f8fafc;
        color: #1f2937;
      }
      .card { width: 100%; max-width: 22rem; text-align: center; }
      h1 { font-size: 1.25rem; margin: 0 0 0.5rem; }
      p { font-size: 0.875rem; color: #4b5563; margin: 0 0 1.5rem; line-height: 1.5; }
      .cta {
        display: block;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        background: #4f46e5;
        color: #fff;
        font-weight: 600;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1><%= t('mobile_handoff.title') %></h1>
      <p><%= t('mobile_handoff.body') %></p>
      <a class="cta" href="<%= @deep_link %>"><%= t('mobile_handoff.cta') %></a>
    </div>
  </body>
</html>
